{
  "name": "finn-desktop",
  "productName": "Finn",
  "version": "0.2.0",
  "description": "Finn der Fennek – Lernbegleiter für die Grundschule",
  "main": "main.js",
  "private": true,
  "author": "Sebastian Ostholt",
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder --mac --dir"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "de.hoai.finn",
    "productName": "Finn",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*",
          "!manifest.json"
        ]
      }
    ],
    "icon": "../web/icon-512.png",
    "mac": {
      "category": "public.app-category.education",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Finn möchte hören, was du sagst."
      }
    },
    "publish": null
  },
  "repository": "github:HOAI-droid/Finn"
}
